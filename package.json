{
  "name": "control-gastos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test": "vitest run --exclude \"src/lib/firestore/__tests__/**\" --reporter=dot",
    "test:watch": "vitest --exclude \"src/lib/firestore/__tests__/**\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-presupuesto \"vitest run src/lib/firestore/__tests__ --no-file-parallelism --reporter=dot\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
